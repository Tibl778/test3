From: Ystervos
Subject: [PATCH] Gecko - Trust the Ystervos add-on signing root

Adds the Ystervos root CA to the add-on signature trust anchors, next to
Mozilla's AMO production root. Add-ons signed by either install normally;
xpinstall.signatures.required stays on.
---
diff --git a/security/manager/ssl/moz.build b/security/manager/ssl/moz.build
index 4443d70..197377e 100644
--- a/security/manager/ssl/moz.build
+++ b/security/manager/ssl/moz.build
@@ -282,7 +282,12 @@ headers_arrays_certs = [
             "tests/unit/test_signed_apps/xpcshellTestRoot2.pem",
         ],
     ),
-    ("addons-public.inc", "addonsPublicRoots", ["addons-public.pem"]),
+    (
+        "addons-public.inc",
+        "addonsPublicRoots",
+        # Ystervos: also trust add-ons signed with the Ystervos add-on root CA.
+        ["addons-public.pem", "ystervos-addons-root.pem"],
+    ),
     (
         "addons-public-intermediate.inc",
         "addonsPublicIntermediates",
diff --git a/security/manager/ssl/ystervos-addons-root.pem b/security/manager/ssl/ystervos-addons-root.pem
new file mode 100644
index 0000000..619a292
--- /dev/null
+++ b/security/manager/ssl/ystervos-addons-root.pem
@@ -0,0 +1,36 @@
